{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TranscriptionSettings": {
    "PythonPath": "python3",
    "MaxFileSizeMB": 25,
    "TimeoutSeconds": 300,
